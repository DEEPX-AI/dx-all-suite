    ],
    "params": []
  },
  {
    "op": "volume",
    "type": "cpu",
    "summary": "a volume proxy per package box from its instance mask and the depth map under it",
    "inputs": {
      "min": 3,
      "max": 3,
      "accepts": [
        {
          "shape": "boxes",
          "per_crop": false
        },
        {
          "shape": "instances",
          "per_crop": false
        },
        {
          "shape": "densemap",
          "per_crop": false
        }
      ]
    },
    "output": "records",
    "tracking": false,
    "events": [],
    "numbers": [
      "box_x",
      "box_y",
      "box_w",
      "box_h",
      "class_id",
      "mask_area_px",
      "median_depth",
      "volume_proxy"
    ],
    "params": [
      {
        "name": "scale_factor",
        "type": "number",
        "required": false,
        "default": 1,
        "min": 0,
        "step": 0.1,
        "help": "multiplies the proxy; 1.0 leaves it in mask-pixels times depth"
      },
      {
        "name": "classes",
        "type": "text_list",
        "required": false,
        "items": "string",
        "when_omitted": [
          "backpack",
          "handbag",
          "suitcase",
          "box",
          "package",
          "luggage"
        ],
        "help": "package class names; leave it out for the built-in ones (when_omitted), [] to match none"
      },
      {
        "name": "class_ids",
        "type": "text_list",
        "required": false,
        "items": "integer",
        "when_omitted": [
          "24",
          "26",
          "28"
        ],
        "help": "package class ids, each an integer written as a string (\"24\"); leave it out for the built-in ones (when_omitted), [] to match none"
      }
    ]
  }
]
