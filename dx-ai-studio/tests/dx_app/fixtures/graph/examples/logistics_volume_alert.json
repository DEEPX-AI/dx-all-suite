{
  "version": 1,
  "name": "logistics-volume-alert",
  "nodes": [
    { "id": "cam",    "type": "source", "uri": "sample/img/sample_baggage_cart_airport.jpg" },
    { "id": "det",    "model": "yolo26-n_640x640" },
    { "id": "seg",    "model": "yolo26-n-seg_640x640" },
    { "id": "depth",  "model": "yolo26-depth-n_768x768" },
    { "id": "volume", "type": "cpu", "op": "volume" },
    { "id": "load",   "type": "logic", "op": "condition",
      "params": { "value": "volume_proxy", "comparator": ">", "threshold": 100, "reduce": "sum",
                  "cooldown_s": 10, "event": "load_high" } }
  ],
  "edges": [
    { "from": "cam",    "to": "det" },
    { "from": "cam",    "to": "seg" },
    { "from": "cam",    "to": "depth" },
    { "from": "det",    "to": "volume", "carry": "result" },
    { "from": "seg",    "to": "volume", "carry": "result" },
    { "from": "depth",  "to": "volume", "carry": "result" },
    { "from": "volume", "to": "load",   "carry": "result" }
  ]
}
